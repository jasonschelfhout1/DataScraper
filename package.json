{
  "name": "omgevingsloket-document-downloader",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <26"
  },
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend",
    "test": "npm run test --workspaces --if-present",
    "discover": "tsx scripts/discover.ts",
    "authorize": "tsx scripts/authorize.ts",
    "scrape": "tsx scripts/scrape.ts",
    "test:integration": "tsx scripts/integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "crawl:once": "tsx scripts/crawl-once.ts",
    "crawl:worker": "tsx scripts/crawl-worker.ts",
    "crawl:status": "tsx scripts/crawl-status.ts",
    "crawl:resume": "tsx scripts/crawl-resume.ts",
    "crawl:project": "tsx scripts/crawl-project.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
