PORT=3001
AUTH_USERNAME=owen.philips
AUTH_PASSWORD=123456789!
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_MS=86400000
AUTH_LOGIN_WINDOW_MS=900000
AUTH_MAX_LOGIN_ATTEMPTS=5
DATABASE_URL=postgres://datascraper:datascraper@localhost:5432/datascraper
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Strict application cap: 8 GiB, below R2's 10 GB/month Standard-storage free tier.
ARCHIVE_MAX_STORAGE_BYTES=8589934592
CRAWLER_CONCURRENCY=1
CRAWLER_MIN_REQUEST_DELAY_MS=3000
CRAWLER_REQUEST_JITTER_MS=2000
CRAWLER_BATCH_MAX_MS=480000
CRAWLER_MAX_TASKS_PER_RUN=500
CRAWLER_MAX_ATTEMPTS=5
CRAWLER_TASK_LEASE_MS=900000
CRAWLER_RETRY_BASE_MS=60000
# Completed queue history older than this is removed by the weekly maintenance cron.
CRAWL_TASK_RETENTION_DAYS=7
OMGEVINGSLOKET_BASE_URL=https://omgevingsloketinzage.omgeving.vlaanderen.be
DEBUG_OMGEVINGSLOKET=false
REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=3
CACHE_TTL_MS=300000
DOWNLOAD_JOB_TTL_MS=900000
# Store cookies only in .env locally or as a Render secret. Never commit them.
# OMGEVINGSLOKET_COOKIE_HEADER=session=value; other=value
MAX_ACTIVE_DOWNLOAD_JOBS=2
MAX_DOCUMENTS_PER_DOWNLOAD=100
EXPENSIVE_REQUEST_WINDOW_MS=60000
MAX_EXPENSIVE_REQUESTS_PER_WINDOW=30
# Defaults to .local. On Render, set this to /tmp/datascraper.
# LOCAL_DATA_DIR=/tmp/datascraper
LOG_LEVEL=info
