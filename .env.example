PORT=3001
AUTH_USERNAME=
AUTH_PASSWORD=
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_MS=86400000
AUTH_LOGIN_WINDOW_MS=900000
AUTH_MAX_LOGIN_ATTEMPTS=5
OMGEVINGSLOKET_BASE_URL=https://omgevingsloketinzage.omgeving.vlaanderen.be
DEBUG_OMGEVINGSLOKET=false
REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=3
CACHE_TTL_MS=300000
DOWNLOAD_JOB_TTL_MS=900000
# Store cookies only in .env locally or as a Render secret. Never commit them.
# OMGEVINGSLOKET_COOKIE_HEADER=session=value; other=value
MAX_ACTIVE_DOWNLOAD_JOBS=2
MAX_DOCUMENTS_PER_DOWNLOAD=100
EXPENSIVE_REQUEST_WINDOW_MS=60000
MAX_EXPENSIVE_REQUESTS_PER_WINDOW=30
# Defaults to .local. On Render, set this to /tmp/datascraper.
# LOCAL_DATA_DIR=/tmp/datascraper
LOG_LEVEL=info
